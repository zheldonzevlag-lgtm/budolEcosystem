{
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "services/api-gateway/index.js", "use": "@vercel/node" },
    { "src": "services/auth-service/index.js", "use": "@vercel/node" },
    { "src": "services/wallet-service/index.js", "use": "@vercel/node" },
    { "src": "services/transaction-service/index.js", "use": "@vercel/node" },
    { "src": "services/payment-gateway-service/api/index.js", "use": "@vercel/node" },
    { "src": "services/verification-service/index.js", "use": "@vercel/node" },
    { "src": "services/settlement-service/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/gateway/(.*)", "dest": "services/api-gateway/index.js" },
    { "src": "/api/notify", "dest": "services/api-gateway/index.js" },
    { "src": "/api/auth/(.*)", "dest": "services/auth-service/index.js" },
    { "src": "/api/wallet/(.*)", "dest": "services/wallet-service/index.js" },
    { "src": "/api/tx/(.*)", "dest": "services/transaction-service/index.js" },
    { "src": "/api/payment-gw/(.*)", "dest": "services/payment-gateway-service/api/index.js" },
    { "src": "/api/kyc/(.*)", "dest": "services/verification-service/index.js" },
    { "src": "/api/settlement/(.*)", "dest": "services/settlement-service/index.js" },
    { "src": "/api/(.*)", "dest": "services/api-gateway/index.js" }
  ],
  "regions": ["sin1"]
}
