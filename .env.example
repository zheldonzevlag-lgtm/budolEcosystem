# =============================================================================
# budolEcosystem - Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running any service.
# NEVER commit .env files to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Configuration (REQUIRED for all services)
# -----------------------------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/budolpay

# -----------------------------------------------------------------------------
# budolID (SSO Service)
# -----------------------------------------------------------------------------
# Port for budolID
PORT=8000

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# CAPTCHA secret (optional, auto-generated if not set)
CAPTCHA_SECRET=

# BudolPay database URL (for budolID to sync users)
BUDOLPAY_DATABASE_URL=

# BudolShap database URL (for budolID to sync users)
BUDOLSHAP_DATABASE_URL=

# BudolAccounting database URL
BUDOLACCOUNTING_DATABASE_URL=

# -----------------------------------------------------------------------------
# API Gateway
# -----------------------------------------------------------------------------
# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:8001
WALLET_SERVICE_URL=http://wallet-service:8002
TRANSACTION_SERVICE_URL=http://transaction-service:8003
PAYMENT_GATEWAY_URL=http://payment-gateway:8004

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Auth Service
# -----------------------------------------------------------------------------
# Database URL (same as above)
DATABASE_URL=

# JWT Secret (same as above)
JWT_SECRET=

# BudolID SSO URL
SSO_URL=http://localhost:8000

# BudolPay API key (for SSO integration)
BUDOLPAY_API_KEY=

# -----------------------------------------------------------------------------
# Wallet Service
# -----------------------------------------------------------------------------
# Database URL
DATABASE_URL=

# Auth Service URL (for token verification)
AUTH_SERVICE_URL=http://auth-service:8001

# -----------------------------------------------------------------------------
# Transaction Service
# -----------------------------------------------------------------------------
# Database URL
DATABASE_URL=

# Auth Service URL (for token verification)
AUTH_SERVICE_URL=http://auth-service:8001

# Wallet Service URL (for balance operations)
WALLET_SERVICE_URL=http://wallet-service:8002

# -----------------------------------------------------------------------------
# WebSocket Server
# -----------------------------------------------------------------------------
# JWT Secret (same as above)
JWT_SECRET=

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Internal API key for /trigger endpoint (backend services use this)
INTERNAL_API_KEY=

# Port
PORT=4000

# -----------------------------------------------------------------------------
# BudolShap (Next.js Frontend)
# -----------------------------------------------------------------------------
# BudolID SSO URL
NEXT_PUBLIC_SSO_URL=http://localhost:8000

# BudolID API Key
NEXT_PUBLIC_SSO_API_KEY=

# WebSocket URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Database URL
DATABASE_URL=

# Pusher (if using Pusher instead of Socket.io)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# -----------------------------------------------------------------------------
# BudolPay Admin Dashboard
# -----------------------------------------------------------------------------
# BudolID SSO URL
NEXT_PUBLIC_SSO_URL=http://localhost:8000

# BudolID API Key
NEXT_PUBLIC_SSO_API_KEY=

# Database URL
DATABASE_URL=

# WebSocket URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Third-Party Services (rotate these secrets)
# -----------------------------------------------------------------------------
# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Lalamove
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET_ID=PH

# Prisma Accelerate (if using)
PRISMA_ACCELERATE_URL=

# Brevo (email)
BREVO_API_KEY=

# Zerix (SMS)
ZERIX_API_KEY=

# iTextMo (SMS)
ITEXTMO_API_KEY=
ITEXTMO_CLIENT_CODE=
